# Backend environment variables for local development
NODE_ENV=development
PORT=3000
MONGO_URL=mongodb://127.0.0.1:27017/yomart_local
JWT_SECRET=replace-with-a-random-secret-before-running
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=8h

# Default admin account values
ADMIN_USERNAME=your-admin-username
ADMIN_NAME=Your Admin Name
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Optional services
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# Video stories stay disabled until the owner approves a maximum duration in seconds.
STORY_MAX_DURATION_SECONDS=
# Optional persistent disk path. Required for production uploads when Cloudinary is not configured.
UPLOADS_DIR=
# Private receipt persistence. Required in production when authenticated Cloudinary storage is not configured.
PAYMENT_PROOFS_DIR=
# Leave both unset until the business owner separately approves each retention period.
PAYMENT_PROOF_ORPHAN_RETENTION_DAYS=
PAYMENT_PROOF_SUPERSEDED_RETENTION_DAYS=
ONE_SIGNAL_APP_ID=your-one-signal-app-id
ONE_SIGNAL_REST_API_KEY=your-one-signal-rest-api-key

# Production/staging sales are opt-in. Set false until owner-approved prices and stock exist.
# YOMART_SALES_ENABLED=false
# PLATFORM=Production

# Exact HTTPS web origins are required in staging/production. These localhost
# examples are for local development only and must not be used in deployments.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
